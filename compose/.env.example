# Copy to .env and edit. Never commit .env.
#
# One token per application, generated separately, so a compromise is contained:
#   openssl rand -hex 32

EVENT_SLUG=my-event-2027

# Admin allow-list. EMPTY MEANS DENY EVERYONE — deliberately.
AUTHORIZED_PRINCIPALS=you@example.edu,colleague@example.edu

RECONCILER_WEBHOOK_TOKEN=
LODGING_WEBHOOK_TOKEN=
NAMETAG_WEBHOOK_TOKEN=
GALLERY_WEBHOOK_TOKEN=

# ticket-reconciler only.
EVENTBRITE_API_TOKEN=
EVENTBRITE_EVENT_ID=

# Discount codes are semi-public — the browser receives the computed value — but
# they still do not belong in git.
EVENTBRITE_DISCOUNT_GENERAL=
EVENTBRITE_DISCOUNT_AFFILIATE=

# link-forge only. JSON: {"speaker@example.edu": "<token>"}
SPEAKER_LINK_TOKENS={}
DOCUSIGN_MEDIA_RELEASE_FORM_ID=

# Restore truncates every table. Leave it off until the moment you need it.
ENABLE_RESTORE=False
